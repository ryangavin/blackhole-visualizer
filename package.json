{
  "name": "blackhole-visualizer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "start": "node scripts/start.ts",
    "dev": "export PORT=${PORT:-$(node -e \"const s=require('net').createServer().listen(0,'127.0.0.1',()=>{console.log(s.address().port);s.close()})\")} && tauri dev --config \"{\\\"build\\\":{\\\"devUrl\\\":\\\"http://127.0.0.1:$PORT\\\"}}\"",
    "web:dev": "npm run presets:prepare && vite --host 127.0.0.1",
    "web:build": "npm run presets:prepare && tsc --noEmit && vite build",
    "build": "tauri build --bundles app",
    "tauri": "tauri",
    "presets:prepare": "node scripts/import-presets.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "butterchurn": "2.6.7",
    "butterchurn-presets": "2.4.7"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.0"
  }
}
