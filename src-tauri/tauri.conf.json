{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BlackHole Visualizer",
  "version": "0.1.0",
  "identifier": "com.ryangavin.blackhole-visualizer",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run web:dev",
    "beforeBuildCommand": "npm run web:build"
  },
  "app": {
    "windows": [{ "label": "main", "title": "BlackHole Visualizer", "width": 1440, "height": 900, "minWidth": 800, "minHeight": 560, "backgroundColor": "#08090c" }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [],
    "macOS": { "minimumSystemVersion": "12.0", "entitlements": "Entitlements.plist", "infoPlist": "Info.plist" }
  }
}
